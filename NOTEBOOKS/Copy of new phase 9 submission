ib.dump(best_gb_model, model_filename)\n","print(f\"Model pipeline successfully saved to: {model_filename}\")"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Model pipeline successfully saved to: churn_prediction_pipeline.joblib\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"13c0ed43","executionInfo":{"status":"ok","timestamp":1794414969094,"user_tz":-60,"elapsed":239,"user":{"displayName":"THERESA TERFA","userId":"01331411577232298609"}},"outputId":"91fcf016-de70-413c-a055-e662d1c41e17"},"source":["%%writefile app.py\n","from flask import Flask, request, jsonify\n","import joblib\n","import pandas as pd\n","\n","app = Flask(__name__)\n","\n","# Load the pre-trained pipeline securely\n","try:\n","    pipeline = joblib.load('churn_prediction_pipeline.joblib')\n","    print(\"Model loaded successfully!\")\n","except Exception as e:\n","    print(f\"Error loading model: {e}\")\n","    pipeline = None\n","\n","@app.route('/predict', methods=['POST'])\n","def predict():\n","    if pipeline is None:\n","        return jsonify({\"error\": \"Model is not initialized or loaded.\"}), 500\n","\n","    data = request.get_json(silent=True)\n","    if not data:\n","        return jsonify({\"error\": \"Invalid input: No JSON payload provided.\"}), 400\n","\n","    # Ensure data is formatted as a list of records or single record\n","    if isinstance(data, dict):\n","        records = [data]\n","    elif isinstance(data, list):\n","        records = data\n","    else:\n","        return jsonify({\"error\": \"Invalid input format. Must be a JSON object or array.\"}), 400\n","\n","    # Required feature fields\n","    required_fields = [\n","        'gender', 'state', 'membership_tier', 'preferred_channel', 'referral_source',\n","        'frequency', 'total_spend', 'avg_spend_per_order',\n","        'ticket_count', 'avg_satisfaction', 'avg_resolution_time'\n","    ]\n","\n","    # Validate and build DataFrame\n","    cleaned_records = []\n","    for i, r in enumerate(records):\n","        cleaned_record = {}\n","        for field in required_fields:\n","            if field not in r:\n","                return jsonify({\"error\": f\"Missing required field '{field}' in record {i}.\"}), 400\n","            cleaned_record[field] = r[field]\n","        cleaned_records.append(cleaned_record)\n","\n","    try:\n","        # Convert to Pandas DataFrame matching model input expectations\n","        df_input = pd.DataFrame(cleaned_records)\n","\n","        # Generate predictions and probabilities\n","        predictions = pipeline.predict(df_input).tolist()\n","        probabilities = pipeline.predict_proba(df_input)[:, 1].tolist()\n","\n","        response = []\n","        for pred, prob in zip(predictions, probabilities):\n","            response.append({\n","                \"is_churned_prediction\": int(pred),\n","                \"churn_probability\": round(float(prob), 4),\n","                \"status\": \"Churn\" if pred == 1 else \"Retained\"\n","            })\n","\n","        return jsonify({\"results\": response})\n","\n","    except Exception as e:\n","        return jsonify({\"error\": f\"An error occurred during inference: {str(e)}\"}), 500\n","\n","if __name__ == '__main__':\n","    # Bind to localhost on port 5000\n","    app.run(host='127.0.0.1', port=5000)"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Writing app.py\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"0ea2f513","executionInfo":{"status":"ok","timestamp":1794414973287,"user_tz":-60,"elapsed":3074,"user":{"displayName":"THERESA TERFA","userId":"01331411577232298609"}},"outputId":"9a76634c-e230-4eee-aeac-3bd1790d4df5"},"source":["import subprocess\n","import time\n","import requests\n","\n","# Start the Flask app in the background\n","print(\"Launching Flask server in the background...\")\n","server_process = subprocess.Popen(['python', 'app.py'])\n","time.sleep(3) # Allow the API server a few seconds to fully boot up\n","\n","# Define API endpoint url\n","url = 'http://127.0.0.1:5000/predict'\n","\n","# Setup test cases representing two distinct profiles\n","sample_payload = [\n","    {\n","        \"gender\": \"F\",\n","        \"state\": \"FLORIDA\",\n","        \"membership_tier\": \"VIP\",\n","        \"preferred_channel\": \"Online\",\n","        \"referral_source\": \"Email Campaign\",\n","        \"frequency\": 25,\n","        \"total_spend\": 12500.50,\n","        \"avg_spend_per_order\": 500.02,\n","        \"ticket_count\": 0,\n","        \"avg_satisfaction\": 5.0,\n","        \"avg_resolution_time\": 0.0\n","    },\n","    {\n","        \"gender\": \"M\",\n","        \"state\": \"TEXAS\",\n","        \"membership_tier\": \"Standard\",\n","        \"preferred_channel\": \"In-Store\",\n","        \"referral_source\": \"Social Media\",\n","        \"frequency\": 1,\n","        \"total_spend\": 45.00,\n","        \"avg_spend_per_order\": 45.00,\n","        \"ticket_count\": 5,\n","        \"avg_satisfaction\": 1.5,\n","        \"avg_resolution_time\": 48.2\n","    }\n","]\n","\n","try:\n","    # Send POST request\n","    print(\"Sending test payload to Flask /predict...\")\n","    response = requests.post(url, json=sample_payload)\n","\n","    print(f\"\\nHTTP Status Code: {response.status_code}\")\n","    import json\n","    print(json.dumps(response.json(), indent=2))\n","\n","finally:\n","    # Clean up and terminate Flask server background process safely\n","    print(\"\\nShutting down backend Flask server...\")\n","    server_process.terminate()"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Launching Flask server in the background...\n","Sending test payload to Flask /predict...\n","\n","HTTP Status Code: 200\n","{\n","  \"results\": [\n","    {\n","      \"churn_probability\": 0.5087,\n","      \"is_churned_prediction\": 1,\n","      \"status\": \"Churn\"\n","    },\n","    {\n","      \"churn_probability\": 0.8557,\n","      \"is_churned_prediction\": 1,\n","      \"status\": \"Churn\"\n","    }\n","  ]\n","}\n","\n","Shutting down backend Flask server...\n"]}]},{"cell_type":"markdown","metadata":{"id":"7c89737c"},"source":["### **1. Simple  Explanation of Predictors**\n","* **Loyalty & Tenure Dynamics**: The most important factors driving churn scores are the frequency and consistency of customers transactions. Customers who make purchases regularly or  repeat purchases are highly unlikely to churn, which shows strong habitual engagement.\n","* **Monetary Value Concentration**: Customers who have spent so much on purchases over a very long period of time or have high average order values are significantly unlikely to leave. on the other hands, low-ticket, single-purchase customers pose the highest flight risk.\n","* **Support Friction**: Customer support activity plays a large role. A cluster of multiple support tickets combined with a dropping satisfaction score (below 4.0 out of 5.0) strongly flags a customer who has reached their breaking point and is highly susceptible to leaving for a competitor.\n","\n","---\n","\n","### **2. Real-World Consequences of Wrong Predictions**\n","* **Consequence of a False Negative (Type II Error)**: The model predicts a customer will **stay**, but they actually **churn**.\n","  * *Operational Impact*: We take no protective action. The customer leaves quietly, and we lose their ongoing revenue streams. Re-acquiring them will require expensive targeted remarketing campaigns that might not succeed.\n","* **Consequence of a False Positive (Type I Error)**: The model predicts a customer will **churn**, but they actually intended to **stay**.\n","  * *Operational Impact*: This action misleads because it will makes us to  proactively send them a high-value retention offer (e.g., VIP service credit,discounts, etc. ). While this encourages customers to stay,it acts as a \"margin drain\" because we needlessly gave up revenue on a transaction that would have occurred naturally.\n","\n","---\n","\n","### **3. Model Limitations & Sources of Bias**\n","* **The 180-day Inactivity Definition Bias**: Classifying any customer who has not ordered within 180 days as \"churned\" introduces a distinct systemic bias. This definition severely disadvantages **highly seasonal buyers** (e.g., those who buy exclusively during holiday or festive periods) or shoppers of highly durable goods. The model will flag these users as churned, potentially flooding them with irrelevant weekly discounts, which may put them of and harm the brand.\n","* **Ticket Volume Representation Gap**: Support tickets only capture customers who take the time to complain. A major limitation is \"silent churners\"— dissatisfied or disengaged customers who leave without ever opening a support ticket. Because the model relies heavily on ticket volume to gauge friction, it may fail to identify the number of those who are silently leaving."]}]}