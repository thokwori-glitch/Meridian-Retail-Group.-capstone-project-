tus":"ok","timestamp":1793544889603,"user_tz":-60,"elapsed":8778,"user":{"displayName":"THERESA TERFA","userId":"01331411577232298609"}},"outputId":"86e10a32-e681-41cc-de69-63c30478452c"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Customer data loaded successfully!\n","Order Items data loaded successfully!\n","Order data loaded successfully!\n","Product data loaded successfully!\n","Support Ticket data loaded successfully!\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"FitTdpf4Wwu2"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["PHASE 9"],"metadata":{"id":"IQIR6aQ6ZIkU"}},{"cell_type":"markdown","metadata":{"id":"c4d5252d"},"source":["## PHASE 9: Machine Learning\n","In this section, we prepare our data, train baseline + advanced classifiers, optimize hyperparameters, apply an ensemble model, and compare performance metrics against a basic Neural Network."]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"691c02d9","executionInfo":{"status":"ok","timestamp":1792585433725,"user_tz":-60,"elapsed":761,"user":{"displayName":"THERESA TERFA","userId":"01331411577232298609"}},"outputId":"c3a0c721-f1eb-46bd-94e2-afb85882b03c"},"source":["from sklearn.model_selection import train_test_split, GridSearchCV\n","from sklearn.preprocessing import StandardScaler, OneHotEncoder\n","from sklearn.compose import ColumnTransformer\n","from sklearn.pipeline import Pipeline\n","from sklearn.dummy import DummyClassifier\n","from sklearn.linear_model import LogisticRegression\n","from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier, VotingClassifier\n","from sklearn.neural_network import MLPClassifier\n","from sklearn.metrics import classification_report, roc_auc_score, f1_score, accuracy_score\n","\n","# 1. Feature Selection (Avoiding Target Leakage)\n","# Exclude: 'recency_days', 'last_order_date', 'customer_id', 'first_name', 'last_name', 'email', 'phone', 'city', 'signup_date', 'signup_cohort', 'is_churned'\n","\n","feature_cols = [\n","    'gender', 'state', 'membership_tier', 'preferred_channel', 'referral_source',\n","    'frequency', 'total_spend', 'avg_spend_per_order',\n","    'ticket_count', 'avg_satisfaction', 'avg_resolution_time'\n","]\n","\n","X = df_eda[feature_cols].copy()\n","y = df_eda['is_churned'].astype(int)\n","\n","# 2. Splitting Train & Test sets\n","X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.20, random_state=42, stratify=y)\n","\n","print(f\"Train size: {X_train.shape[0]} | Test size: {X_test.shape[0]}\")\n","print(f\"Class Imbalance (Train set Churn rate): {y_train.mean():.2%}\")"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Train size: 4872 | Test size: 1218\n","Class Imbalance (Train set Churn rate): 67.24%\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"f390c345","executionInfo":{"status":"ok","timestamp":1792585458609,"user_tz":-60,"elapsed":183,"user":{"displayName":"THERESA TERFA","userId":"01331411577232298609"}},"outputId":"0d6316f0-e35c-41fb-abbe-b220e277c3ff"},"source":["# 3. Pipeline Preprocessing definition\n","numeric_features = ['frequency', 'total_spend', 'avg_spend_per_order', 'ticket_count', 'avg_satisfaction', 'avg_resolution_time']\n","categorical_features = ['gender', 'state', 'membership_tier', 'preferred_channel', 'referral_source']\n","\n","preprocessor = ColumnTransformer(\n","    transformers=[\n","        ('num', StandardScaler(), numeric_features),\n","        ('cat', OneHotEncoder(handle_unknown='ignore', sparse_output=False), categorical_features)\n","    ]\n",")\n","\n","# Create Dummy Classifier baseline (always predicts majority class)\n","dummy_clf = Pipeline(steps=[('preprocessor', preprocessor), ('classifier', DummyClassifier(strategy='most_frequent'))])\n","dummy_clf.fit(X_train, y_train)\n","y_pred_dummy = dummy_clf.predict(X_test)\n","\n","print(\"--- Baseline (Majority Class) Performance ---\")\n","print(f\"Accuracy: {accuracy_score(y_test, y_pred_dummy):.2%}\")\n","print(f\"F1 Score: {f1_score(y_test, y_pred_dummy, zero_division=0):.2f}\")"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["--- Baseline (Majority Class) Performance ---\n","Accuracy: 67.24%\n","F1 Score: 0.80\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"d3aff7d0","executionInfo":{"status":"ok","timestamp":1792585479396,"user_tz":-60,"elapsed":3945,"user":{"displayName":"THERESA TERFA","userId":"01331411577232298609"}},"outputId":"65a52734-acbe-4337-ae93-ff364aaf6df3"},"source":["# 4. Training 3 distinct models with pipelines\n","models = {\n","    'Logistic Regression': LogisticRegression(max_iter=1000, random_state=42),\n","    'Random Forest': RandomForestClassifier(random_state=42, n_estimators=100),\n","    'Gradient Boosting': GradientBoostingClassifier(random_state=42)\n","}\n","\n","results = {}\n","\n","for name, clf in models.items():\n","    pipeline = Pipeline(steps=[('preprocessor', preprocessor), ('classifier', clf)])\n","    pipeline.fit(X_train, y_train)\n","\n","    y_pred = pipeline.predict(X_test)\n","    y_prob = pipeline.predict_proba(X_test)[:, 1]\n","\n","    # Evaluate train performance to check for overfitting\n","    y_train_pred = pipeline.predict(X_train)\n","    train_acc = accuracy_score(y_train, y_train_pred)\n","    test_acc = accuracy_score(y_test, y_pred)\n","\n","    results[name] = {\n","        'Pipeline': pipeline,\n","        'Test Accuracy': test_acc,\n","        'Train Accuracy': train_acc,\n","        'F1 Score': f1_score(y_test, y_pred),\n","        'ROC-AUC': roc_auc_score(y_test, y_prob)\n","    }\n","\n","    print(f\"\\n--- {name} Results ---\")\n","    print(f\"Train Accuracy: {train_acc:.2%} | Test Accuracy: {test_acc:.2%}\")\n","    print(f\"F1 Score: {f1_score(y_test, y_pred):.2f} | ROC-AUC: {roc_auc_score(y_test, y_prob):.2f}\")"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","--- Logistic Regression Results ---\n","Train Accuracy: 66.87% | Test Accuracy: 66.50%\n","F1 Score: 0.79 | ROC-AUC: 0.62\n","\n","--- Random Forest Results ---\n","Train Accuracy: 100.00% | Test Accuracy: 66.26%\n","F1 Score: 0.79 | ROC-AUC: 0.59\n","\n","--- Gradient Boosting Results ---\n","Train Accuracy: 70.36% | Test Accuracy: 66.58%\n","F1 Score: 0.79 | ROC-AUC: 0.62\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"3c85207f","executionInfo":{"status":"ok","timestamp":1792585568795,"user_tz":-60,"elapsed":23563,"user":{"displayName":"THERESA TERFA","userId":"01331411577232298609"}},"outputId":"04b9e7c1-c9f9-4e9b-f4c4-9bfc7b0fa166"},"source":["# 5. Hyperparameter Tuning using GridSearchCV on the best candidate (Gradient Boosting)\n","# (We tune min_samples_split and learning_rate to balance under/overfitting)\n","gb_pipeline = Pipeline(steps=[('preprocessor', preprocessor), ('classifier', GradientBoostingClassifier(random_state=42))])\n","\n","param_grid = {\n","    'classifier__learning_rate': [0.05, 0.1],\n","    'classifier__n_estimators': [50, 100],\n","    'classifier__max_depth': [3, 5]\n","}\n","\n","grid_search = GridSearchCV(gb_pipeline, param_grid, cv=3, scoring='f1', n_jobs=-1)\n","grid_search.fit(X_train, y_train)\n","\n","best_gb_model = grid_search.best_estimator_\n","print(f\"Best parameters found: {grid_search.best_params_}\")\n","print(f\"Optimized F1 Score (Validation): {grid_search.best_score_:.2f}\")"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Best parameters found: {'classifier__learning_rate': 0.05, 'classifier__max_depth': 3, 'classifier__n_estimators': 50}\n","Optimized F1 Score (Validation): 0.80\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"fb0353e4","executionInfo":{"status":"ok","timestamp":1792585726692,"user_tz":-60,"elapsed":2548,"user":{"displayName":"THERESA TERFA","userId":"01331411577232298609"}},"outputId":"9d0b9bfb-ce0c-4c30-f3cb-a392717d32f1"},"source":["# 6. Ensemble: Voting Classifier combining Random Forest & Gradient Boosting\n","voting_clf = VotingClassifier(\n","    estimators=[\n","        ('rf', models['Random Forest']),\n","        ('gb', best_gb_model.named_steps['classifier'])\n","    ],\n","    voting='soft'\n",")\n","\n","ensemble_pipeline = Pipeline(steps=[('preprocessor', preprocessor), ('classifier', voting_clf)])\n","ensemble_pipeline.fit(X_train, y_train)\n","y_pred_ens = ensemble_pipeline.predict(X_test)\n","y_prob_ens = ensemble_pipeline.predict_proba(X_test)[:, 1]\n","\n","print(\"\\n--- Ensemble Voting Classifier Results ---\")\n","print(f\"Test Accuracy: {accuracy_score(y_test, y_pred_ens):.2%}\")\n","print(f\"F1 Score: {f1_score(y_test, y_pred_ens):.2f} | ROC-AUC: {roc_auc_score(y_test, y_prob_ens):.2f}\")"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","--- Ensemble Voting Classifier Results ---\n","Test Accuracy: 66.91%\n","F1 Score: 0.80 | ROC-AUC: 0.61\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"5f7322a0","executionInfo":{"status":"ok","timestamp":1792585598749,"user_tz":-60,"elapsed":870,"user":{"displayName":"THERESA TERFA","userId":"01331411577232298609"}},"outputId":"7b418489-2377-4bb5-bec2-9a97d17ff931"},"source":["# 7. Neural Network Comparison (MLPClassifier)\n","mlp_clf = MLPClassifier(hidden_layer_sizes=(64, 32), max_iter=500, random_state=42, early_stopping=True)\n","mlp_pipeline = Pipeline(steps=[('preprocessor', preprocessor), ('classifier', mlp_clf)])\n","mlp_pipeline.fit(X_train, y_train)\n","\n","y_pred_mlp = mlp_pipeline.predict(X_test)\n","y_prob_mlp = mlp_pipeline.predict_proba(X_test)[:, 1]\n","\n","print(\"--- Neural Network (MLP) Results ---\")\n","print(f\"Test Accuracy: {accuracy_score(y_test, y_pred_mlp):.2%}\")\n","print(f\"F1 Score: {f1_score(y_test, y_pred_mlp):.2f} | ROC-AUC: {roc_auc_score(y_test, y_prob_mlp):.2f}\")"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["--- Neural Network (MLP) Results ---\n","Test Accuracy: 67.00%\n","F1 Score: 0.80 | ROC-AUC: 0.63\n"]}]},{"cell_type":"markdown","metadata":{"id":"39f01fd1"},"source":["### **PHASE 9: Model Evaluation & Business Justification**\n","\n","When deploying a churn prediction model, evaluating it purely on **Accuracy** can be highly misleading—especially if the classes are imbalanced. Instead, we must prioritize metrics aligned with our specific business costs:\n","\n","1. **False Negative (FN)**: The model predicts a customer will **stay**, but they actually **churn**.\n","   * *Business Cost*: Extremely High. We lose the customer permanently, along with their entire Customer Lifetime Value (CLV). Re-acquiring a lost customer is historically 5 to 25 times more expensive than retaining an existing one.\n","2. **False Positive (FP)**: The model predicts a customer will **churn**, but they actually intended to **stay**.\n","   * *Business Cost*: Moderate. We might target them with a retention offer or incentive discount (e.g., $10 off or a free month). While this wastes a small amount of margin on someone who didn't need it, the cost is significantly lower than losing a customer entirely.\n","\n","### **Key Metrics Selection & Justification**\n","* **Recall (Sensitivity)**: **This is our primary metric.** High recall ensures we capture the maximum percentage of actual churners (minimizing False Negatives), allowing the business to proactively intervene.\n","* **F1-Score**: Since maximizing Recall blindly can lead to a deluge of False Positives (over-allocating incentives), the **F1-Score** (harmonic mean of Precision and Recall) serves as our balanced optimization target to protect both the retention budget and customer save-rates.\n","* **ROC-AUC Score**: Measures the model's ability to distinguish between churners and non-churners across all classification thresholds, serving as an indicator of overall ranking performance."]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":970},"id":"1c953ad4","executionInfo":{"status":"ok","timestamp":1792587570846,"user_tz":-60,"elapsed":2338,"user":{"displayName":"THERESA TERFA","userId":"01331411577232298609"}},"outputId":"10ddc56b-2b68-47d6-c040-aac128870ccf"},"source":["import matplotlib.pyplot as plt\n","import seaborn as sns\n","import pandas as pd\n","from sklearn.metrics import confusion_matrix, classification_report, f1_score, recall_score, precision_score, roc_auc_score\n","\n","# Prepare list to hold evaluation data for comparative analysis\n","eval_summary = []\n","\n","# Collect metrics for all trained pipelines\n","evaluated_models = {\n","    'Baseline (Dummy)': dummy_clf,\n","    'Logistic Regression': results['Logistic Regression']['Pipeline'],\n","    'Random Forest': results['Random Forest']['Pipeline'],\n","    'Gradient Boosting (Tuned)': best_gb_model,\n","    'Voting Ensemble': ensemble_pipeline,\n","    'Neural Network (MLP)': mlp_pipeline\n","}\n","\n","# Configure subplots for Confusion Matrices\n","fig, axes = plt.subplots(2, 3, figsize=(20, 12))\n","axes = axes.ravel()\n","\n","for idx, (name, pipeline) in enumerate(evaluated_models.items()):\n","    # Generate predictions\n","    y_pred_eval = pipeline.predict(X_test)\n","\n","    # Try extracting probabilities safely if supported by model\n","    try:\n","        y_prob_eval = pipeline.predict_proba(X_test)[:, 1]\n","    except (AttributeError, NotImplementedError):\n","        y_prob_eval = y_pred_eval # Fallback if probability not supported\n","\n","    # Calculate key metrics\n","    acc = accuracy_score(y_test, y_pred_eval)\n","    prec = precision_score(y_test, y_pred_eval, zero_division=0)\n","    rec = recall_score(y_test, y_pred_eval, zero_division=0)\n","    f1 = f1_score(y_test, y_pred_eval, zero_division=0)\n","    auc = roc_auc_score(y_test, y_prob_eval)\n","\n","    # Append to summary list\n","    eval_summary.append({\n","        'Model': name,\n","        'Accuracy': acc,\n","        'Precision': prec,\n","        'Recall': rec,\n","        'F1-Score': f1,\n","        'ROC-AUC': auc\n","    })\n","\n","    # Plot Confusion Matrix\n","    cm = confusion_matrix(y_test, y_pred_eval)\n","    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', ax=axes[idx], cbar=False,\n","                xticklabels=['Stay', 'Churn'], yticklabels=['Stay', 'Churn'])\n","    axes[idx].set_title(f\"{name}\\nF1: {f1:.2f} | Recall: {rec:.2f}\", fontsize=12, fontweight='bold')\n","    axes[idx].set_ylabel('Actual Label')\n","    axes[idx].set_xlabel('Predicted Label')\n","\n","# Clean up empty spaces if any\n","for i in range(len(evaluated_models), len(axes)):\n","    fig.delaxes(axes[i])\n","\n","plt.tight_layout()\n","plt.show()\n","\n","# Display summary DataFrame sorted by F1-Score\n","df_eval_summary = pd.DataFrame(eval_summary).sort_values(by='F1-Score', ascending=False)\n","print(\"\\n--- Model Performance Comparison Summary ---\")\n","display(df_eval_summary)"],"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 2000x1200 with 6 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","--- Model Performance Comparison Summary ---\n"]},{"output_type":"display_data","data":{"text/plain":["                       Model  Accuracy  Precision    Recall  F1-Score  \\\n","0           Baseline (Dummy)  0.672414   0.672414  1.000000  0.804124   \n","3  Gradient Boosting (Tuned)  0.671593   0.673571  0.992674  0.802567   \n","4            Voting Ensemble  0.669130   0.674790  0.980464  0.799403   \n","5       Neural Network (MLP)  0.669951   0.676845  0.974359  0.798799   \n","1        Logistic Regression  0.665025   0.680421  0.946276  0.791624   \n","2              Random