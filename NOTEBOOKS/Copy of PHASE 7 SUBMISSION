\n","df_eda = df_customer.merge(last_order, on='customer_id', how='left')\n","\n","# Calculate days since last completed order relative to the overall dataset's max order date\n","df_eda['recency_days'] = (max_order_date - df_eda['last_order_date']).dt.days\n","\n","# Customers who have never ordered or have not ordered in > 180 days are classified as Churned\n","df_eda['recency_days'] = df_eda['recency_days'].fillna(9999)  # Large sentinel value for never ordered\n","df_eda['is_churned'] = df_eda['recency_days'] > 180\n","\n","overall_churn_rate = df_eda['is_churned'].mean()\n","print(f\"Overall Churn Rate: {overall_churn_rate:.2%}\")"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Max Order Date in Dataset: 2026-07-03 00:00:00\n","Overall Churn Rate: 67.24%\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"571310bb","executionInfo":{"status":"ok","timestamp":1792584000249,"user_tz":-60,"elapsed":253,"user":{"displayName":"THERESA TERFA","userId":"01331411577232298609"}},"outputId":"bf431117-115a-461b-cb48-aa6e16ad62ff"},"source":["# --- 2. Compute Churn Rate by Segments ---\n","\n","def get_churn_by_segment(df, segment_col):\n","    summary = df.groupby(segment_col)['is_churned'].agg(['count', 'mean']).reset_index()\n","    summary.rename(columns={'count': 'total_customers', 'mean': 'churn_rate'}, inplace=True)\n","    return summary.sort_values(by='churn_rate', ascending=False)\n","\n","print(\"\\n--- Churn by Membership Tier ---\")\n","display(get_churn_by_segment(df_eda, 'membership_tier'))\n","\n","print(\"\\n--- Churn by Preferred Channel ---\")\n","display(get_churn_by_segment(df_eda, 'preferred_channel'))\n","\n","print(\"\\n--- Churn by Referral Source ---\")\n","display(get_churn_by_segment(df_eda, 'referral_source'))\n","\n","print(\"\\n--- Churn by Signup Cohort (Top 10) ---\")\n","display(get_churn_by_segment(df_eda, 'signup_cohort').head(10))"],"execution_coun