ly\n","        prices = pd.to_numeric(df['price_usd'] if 'price_usd' in df.columns else df['price'], errors='coerce')\n","    except KeyError as e:\n","        print(f\"KeyError: Price column not found! {e}\")\n","        return []\n","\n","    # Using comprehension to build a dictionary of valid products and their prices\n","    valid_products_dict = {\n","        row['product_name']: price\n","        for index, row in df.iterrows()\n","        if not pd.isna(price := pd.to_numeric(row.get('price_usd', row.get('price')), errors='coerce'))\n","    }\n","\n","    # Using loop and conditional logic to filter based on the threshold\n","    for name, price in valid_products_dict.items():\n","        if price > threshold:\n","            high_value_items.append(f\"{name} (${price:.2f})\")\n","\n","    return high_value_items\n","\n","# --- Demonstration of the robust functions ---\n","\n","# 1. Safe Date Parsing Demo\n","print(\"1. Demostrating Safe Date Parsing:\")\n","df_order['parsed_order_date'] = safe_parse_date(df_order['order_date'])\n","print(\"Orders with parsed dates (First 3 rows):\")\n","display(df_order[['order_id', 'order_date', 'parsed_order_date']].head(3))\n","\n","print(\"\\n\" + \"=\"*50 + \"\\n\")\n","\n","# 2. Filtering with Exception Handling & Comprehensions Demo\n","print(\"2. Demostrating List Filtering & Logic on Product Prices:\")\n","try:\n","    high_value_list = get_high_value_products(df_product, threshold=200.0)\n","    print(f\"Found {len(high_value_list)} products costing over $200.00.\")\n","    print(\"Sample of high-value products:\")\n","    for item in high_value_list[:5]:\n","        print(f\"- {item}\")\n","except ValueError as ve:\n","    print(f\"Validation Error: {ve}\")"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["1. Demostrating Safe Date Parsing:\n","Orders with parsed dates (First 3 rows):\n"]},{"output_type":"display_data","data":{"text/plain":["    order_id  order_date parsed_order