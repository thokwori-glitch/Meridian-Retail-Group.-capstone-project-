ated, which is a classic RFM dynamic.\n","- **Monthly Revenue Trend**: The revenue trend exhibits strong historical spikes followed by baseline growth, allowing us to pinpoint seasons of peak commercial activity."]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":542},"id":"bcebb2e8","executionInfo":{"status":"ok","timestamp":1794476899031,"user_tz":-60,"elapsed":6499,"user":{"displayName":"THERESA TERFA","userId":"01331411577232298609"}},"outputId":"4aae43b7-6257-4551-ddf7-4c6a5f12feb6"},"source":["import plotly.express as px\n","import plotly.graph_objects as go\n","\n","# --- Plotly 1: Interactive Churn Rate by Referral Source and Segment ---\n","referral_summary = df_eda.groupby(['referral_source', 'membership_tier'])['is_churned'].mean().reset_index()\n","referral_summary['churn_pct'] = (referral_summary['is_churned'] * 100).round(2)\n","\n","fig1 = px.bar(\n","    referral_summary,\n","    x='referral_source',\n","    y='churn_pct',\n","    color='membership_tier',\n","    barmode='group',\n","    title='Interactive Churn Rate (%) by Referral Source and Membership Tier',\n","    labels={'referral_source': 'Referral Source', 'churn_pct': 'Churn Rate (%)', 'membership_tier': 'Membership Tier'},\n","    category_orders={'membership_tier': ['Standard', 'Premium', 'VIP']},\n","    color_discrete_sequence=px.colors.qualitative.Pastel\n",")\n","\n","fig1.update_layout(yaxis_ticksuffix='%', hovermode='x unified')\n","fig1.show()"],"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/html":["<html>\n","<head><meta charset=\"utf-8\" /></head>\n","<body>\n","    <div>            <script src=\"https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.5/MathJax.js?config=TeX-AMS-MML_SVG\"></script><script type=\"text/javascript\">if (window.MathJax && window.MathJax.Hub && window.MathJax.Hub.Config) {window.MathJax.Hub.Config({SVG: {font: \"STIX-Web\"}});}</script>                <script type=\"text/javascript\">wind