()\n","print(f\"Max Order Date in Dataset: {max_order_date}\")\n","\n","# Ensure datetimes are clean\n","df_order['order_date'] = pd.to_datetime(df_order['order_date'])\n","df_customer['signup_date'] = pd.to_datetime(df_customer['signup_date'])\n","\n","# Extract signup cohort (Year-Month)\n","df_customer['signup_cohort'] = df_customer['signup_date'].dt.to_period('M')\n","\n","# Get the last completed order date for each customer\n","completed_orders = df_order[df_order['order_status'] == 'Completed']\n","last_order = completed_orders.groupby('customer_id')['order_date'].max().reset_index()\n","last_order.rename(columns={'order_date': 'last_order_date'}, inplace=True)\n","\n","# Merge with customers\n","df_eda = df_customer.merge(last_order, on='customer_id', how='left')\n","\n","# Calculate days since last completed order relative to the overall dataset's max order date\n","df_eda['recency_days'] = (max_order_date - df_eda['last_order_date']).dt.days\n","\n","# Customers who have never ordered or have not ordered in > 180 days are classified as Churned\n","df_eda['recency_days'] = df_eda['recency_days'].fillna(9999)  # Large sentinel value for never ordered\n","df_eda['is_churned'] = df_eda['recency_days'] > 180\n","\n","overall_churn_rate = df_eda['is_churned'].mean()\n","print(f\"Overall Churn Rate: {overall_churn_rate:.2%}\")"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Max Order Date in Dataset: 2026-07-03 00:00:00\n","Overall Churn Rate: 67.24%\n"]}]},{"cell_type":"code","metadata":{"id":"571310bb"},"source":["# --- 2. Compute Churn Rate by Segments ---\n","\n","def get_churn_by_segment(df, segment_col):\n","    summary = df.groupby(segment_col)['is_churned'].agg(['count', 'mean']).reset_index()\n","    summary.rename(columns={'count': 'total_customers', 'mean': 'churn_rate'}, inplace=True)\n","    return summary.sort_values(by='churn_rate', ascending=False)\n","\n","print(\"\\n--- Churn by Membership Tier ---\")\n","dis