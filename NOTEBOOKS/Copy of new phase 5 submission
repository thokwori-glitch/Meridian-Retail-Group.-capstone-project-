ist())\n","print(\"df_order_item columns:\", df_order_item.columns.tolist())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"cENUGyuhfieJ","executionInfo":{"status":"ok","timestamp":1793744322234,"user_tz":-60,"elapsed":65,"user":{"displayName":"THERESA TERFA","userId":"01331411577232298609"}},"outputId":"d5b6a222-dc1d-4c5a-b05f-b7da43dd0351"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["df_product columns: ['product_id', 'product_name', 'category', 'sub_category', 'brand', 'unit_cost', 'unit_price', 'launch_date', 'is_active']\n","df_customer columns: ['customer_id', 'first_name', 'last_name', 'email', 'phone', 'gender', 'date_of_birth', 'signup_date', 'state', 'city', 'membership_tier', 'preferred_channel', 'marketing_opt_in', 'referral_source']\n","df_order_item columns: ['order_item_id', 'order_id', 'product_id', 'quantity', 'unit_price_at_purchase']\n"]}]},{"cell_type":"code","source":["# Defining robust parsing functions using a lambda function, list comprehension, conditional logic, and exception handling.\n","\n","# 1. Lambda function for clean string stripping & float conversion\n","clean_price = lambda val: float(str(val).replace('$', '').strip()) if pd.notna(val) else 0.0\n","\n","def process_and_filter_products(df, price_col, threshold=100.0):\n","    \"\"\"\n","    Processes product prices and filters for high-value items.\n","    Demonstrates: exception handling, lambda functions, list comprehensions, and conditional logic.\n","    \"\"\"\n","    # Exception handling for invalid input or missing columns\n","    if df is None or df.empty:\n","        raise ValueError(\"The provided DataFrame is empty or None.\")\n","\n","    if price_col not in df.columns:\n","        raise KeyError(f\"Expected price column '{price_col}' not found in DataFrame columns: {df.columns.tolist()}\")\n","\n","    # Safe price conversion utilizing our lambda function inside exception handling block\n","    try:\n","        # Convert column to float securely, catching exceptions on completely malformed individual items\n","        parsed_prices = []\n","        for p in df[price_col]:\n","            try:\n","                parsed_prices.append(clean_price(p))\n","            except (ValueError, TypeError):\n","                parsed_prices.append(0.0) # Safe default on error\n","    except Exception as e:\n","        print(f\"Error processing price values: {e}\")\n","        parsed_prices = [0.0] * len(df)\n","\n","    # Store the parsed values safely\n","    df['cleaned_price'] = parsed_prices\n","\n","    # Using list comprehension with conditional logic to filter for products above the threshold\n","    # This matches the requested natural fit for filtering/formatting in one step\n","    high_value_products = [\n","        f\"{row['product_name']} (${row['cleaned_price']:.2f})\"\n","        for index, row in df.iterrows()\n","        if row['cleaned_price'] > threshold\n","    ]\n","\n","    return high_value_products\n","\n","# --- Demonstration of execution ---\n","try:\n","    # We dynamically check which price column exists (e.g. 'price', 'unit_price', 'price_usd')\n","    actual_price_col = [col for col in df_product.columns if 'price' in col.lower()][0]\n","\n","    print(f\"Using price column: '{actual_price_col}'\")\n","    high_value_items = process_and_filter_products(df_product, price_col=actual_price_col, threshold=200.0)\n","\n","    print(f\"\\nSuccessfully filtered {len(high_value_items)} products costing over $200.00.\")\n","    print(\"Sample of high-value products:\")\n","    for item in high_value_items[:5]:\n","        print(f\"- {item}\")\n","except Exception as e:\n","    print(f\"An error occurred during demonstration: {e}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"R33gIEmmj4ge","executionInfo":{"status":"ok","timestamp":1793745473758,"user_tz":-60,"elapsed":22,"user":{"displayName":"THERESA TERFA","userId":"01331411577232298609"}},"outputId":"413ad82a-bb92-413b-fde3-b4b1f4bdd0a1"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Using price column: 'unit_price'\n","\n","Successfully filtered 158 products costing over $200.00.\n","Sample of high-value products:\n","- Cadence Wellness Classic ($415.24)\n","- Northfield Cookware Pro ($645.92)\n","- Lumen Wellness Plus ($571.72)\n","- Crestline Decor ($540.02)\n","- Lumen Accessories Pro ($259.81)\n"]}]},{"cell_type":"code","source":["import numpy as np\n","\n","def flag_price_outliers_numpy(df, price_col='unit_price_at_purchase', threshold=3.0):\n","    \"\"\"\n","    Uses NumPy vectorized operations to compute z-scores and flag outliers.\n","    This avoids slow python loops by operating on the entire array at once.\n","    \"\"\"\n","    if df is None or df.empty:\n","        raise ValueError(\"The DataFrame is empty or None.\")\n","\n","    if price_col not in df.columns:\n","        raise KeyError(f\"Column '{price_col}' not found in the DataFrame.\")\n","\n","    # Convert series to a numpy array\n","    prices = df[price_col].to_numpy()\n","\n","    # Vectorized computation of mean and standard deviation\n","    mean_price = np.mean(prices)\n","    std_price = np.std(prices)\n","\n","    # Avoid division by zero if std is 0\n","    if std_price == 0:\n","        return df.assign(z_score=0.0, is_outlier=False)\n","\n","    # NumPy vectorized operation: element-wise subtraction and division\n","    z_scores = (prices - mean_price) / std_price\n","\n","    # Vectorized boolean mapping\n","    outlier_flags = np.abs(z_scores) > threshold\n","\n","    # Assign results back to a new dataframe\n","    df_result = df.copy()\n","    df_result['price_z_score'] = z_scores\n","    df_result['is_outlier'] = outlier_flags\n","\n","    print(f\"Processed {len(prices)} items using vectorized NumPy calculations.\")\n","    print(f\"Overall Mean Price: ${mean_price:.2f} | Standard Deviation: ${std_price:.2f}\")\n","    r